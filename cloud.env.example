# Copy values into your cloud provider's encrypted environment settings.
# Do not commit a file containing actual passwords, JWTs, or database URLs.
ENVIRONMENT=production
PORT=8080
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_SSL_MODE=auto
REDIS_URL=rediss://:PASSWORD@HOST:6380/0
JWT_SECRET_KEY=replace-with-a-48-byte-random-secret
GUARDAIN_ADMIN_USERNAME=admin
GUARDAIN_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
CORS_ORIGINS=https://admin.example.com,https://triage.example.com
ONNX_MODEL_PATH=backend/models/guardain_muril.onnx
ONNX_TOKENIZER_PATH=backend/models/guardain_tokenizer
